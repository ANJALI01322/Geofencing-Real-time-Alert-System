# ── GeoTrack API ─────────────────────────────────────────────────────────────
# Copy to .env (or set these in your host's dashboard). Never commit real values.

# PostgreSQL connection. Either a key/value DSN or a postgres:// URL works.
# Local (matches docker-compose):
DATABASE_URL=host=localhost port=5432 user=postgres password=postgres dbname=geotrack sslmode=disable
# Hosted (e.g. Render): DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Port the HTTP server listens on (Render/Heroku-style hosts inject this themselves)
PORT=8080

# Comma-separated list of origins allowed by CORS.
# If unset the API allows ALL origins and logs a warning - set it in production.
# Example: CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Authentication ───────────────────────────────────────────────────────────
# Signing key for login tokens: at least 32 characters. Generate one with: openssl rand -hex 32
# If unset, a random key is used per process (logins are lost on every restart) and a warning is logged.
JWT_SECRET=

# First-run admin account (created only if it does not exist yet; password >= 8 chars).
# Never commit real values. Existing accounts are not changed by editing these later.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional read-only demo account, same rules as above.
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=

# ── Operations ───────────────────────────────────────────────────────────────
# Delete vehicle_locations older than this many days, checked hourly. 0 = keep everything.
RETENTION_DAYS=7

# Per-IP rate limit for POST /vehicles/location (requests per minute)
LOCATION_RATE_PER_MIN=600

# Reverse proxies in front of the API (used to find the real client IP). Defaults: 1 on Render, else 0.
# TRUSTED_PROXY_HOPS=1
