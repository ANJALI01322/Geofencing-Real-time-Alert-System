# ── GeoTrack frontend (Vite) ─────────────────────────────────────────────────
# Copy to .env.local. Vite reads these at BUILD time, so redeploy after changing them.

# Base URL of the GeoTrack API (no trailing slash)
VITE_API_URL=http://localhost:8080

# WebSocket endpoint for live alerts.
# Optional: if omitted it is derived from VITE_API_URL (http -> ws, https -> wss) + /ws/alerts
VITE_WS_URL=ws://localhost:8080/ws/alerts

# Production example (HTTPS site => must use wss://):
# VITE_API_URL=https://geofencing-real-time-alert-system-h1vz.onrender.com
# VITE_WS_URL=wss://geofencing-real-time-alert-system-h1vz.onrender.com/ws/alerts

# Optional: show a "Continue as demo viewer" button on the login page.
# Use ONLY a read-only (viewer) account here: these values are baked into the public JS bundle.
# VITE_DEMO_EMAIL=viewer@geotrack.demo
# VITE_DEMO_PASSWORD=GeoTrack-Demo-2026
